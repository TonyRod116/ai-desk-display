{
  "manifest_version": 3,
  "name": "Reloj local · Claude",
  "description": "Consulta de solo lectura de los resets guardados de la cuenta autorizada para el reloj local.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://claude.ai http://127.0.0.1:8787"
  }
}
